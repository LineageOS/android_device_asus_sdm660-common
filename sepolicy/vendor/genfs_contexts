# Double tap to wake
genfscon proc /touchpanel               u:object_r:proc_touchpanel:s0

# Graphics
genfscon sysfs /devices/virtual/graphics/fb0/idle_state         u:object_r:sysfs_graphics:s0

# IIO device
genfscon sysfs /devices/platform/soc/800f000.qcom,spmi/spmi-0/spmi0-00/800f000.qcom,spmi:qcom,pm660@0:rradc@4500/iio:device1/name                 u:object_r:sysfs_iio_devices:s0

# Kgsl
genfscon sysfs /devices/platform/soc/soc:qcom,kgsl-hyp/subsys3/restart_level            u:object_r:sysfs_ssr_toggle:s0

# LED
genfscon sysfs /devices/platform/soc/800f000.qcom,spmi/spmi-0/spmi0-03/800f000.qcom,spmi:qcom,pm660l@3:qcom,leds@d000/leds                 u:object_r:sysfs_graphics:s0

# Power
genfscon proc /sys/kernel/sched_boost                           u:object_r:proc_sched:s0

# Vibrator
genfscon sysfs /devices/platform/soc/800f000.qcom,spmi/spmi-0/spmi0-01/800f000.qcom,spmi:qcom,pm660@1:qcom,haptics@c000/leds/vibrator u:object_r:sysfs_leds:s0

# Wakeup
genfscon sysfs /devices/platform/soc/c1b7000.i2c/i2c-7/7-0048/wakeup                                                                                                                       u:object_r:sysfs_wakeup:s0
